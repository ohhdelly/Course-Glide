# NVIDIA_API_KEY: Optional. Enables the AI Course Advisor's language layer on
# the OpenAI-compatible endpoint at integrate.api.nvidia.com. Without it the
# advisor answers from the rules-based parser alone.
NVIDIA_API_KEY=""

# NVIDIA_MODEL / NVIDIA_FALLBACK_MODELS / NVIDIA_BASE_URL: optional overrides for
# the advisor model chain (primary, comma-separated fallbacks, API base URL).
# NVIDIA_MODEL="nvidia/nemotron-3.5-bolt-e4b"
# NVIDIA_FALLBACK_MODELS="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning,stepfun-ai/step-5-preview"
# NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# GEMINI_API_KEY: Optional. Used only for AI-generated review insights; without
# it those insights come from the deterministic Trust Lens generator.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# UWATERLOO_API_KEY: Optional server-side key for Waterloo Open Data API v3
# (https://openapi.data.uwaterloo.ca/api-docs/index.html) to confirm live
# term-specific course schedules alongside the 2026-2027 Academic Calendar.
UWATERLOO_API_KEY=""
